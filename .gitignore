# Precomputed representations — rebuilt on demand with --rebuild
.cache/

# Retrieval index bundle — rebuilt with `uv run reportfinder-bundle build`.
# Kept out of git deliberately: it holds model-derived vectors that are large,
# machine-specific, and fully reproducible from the workbook plus the manifest.
.bundle/

# Entire data/ directory is local-only now (datasets, workbooks, splits, etc.).
data/
.DS_Store

# Generated test fixture (regenerate: uv run python tests/make_fixture.py)
tests/fixtures/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# Exported inference graphs -- large, host-specific, and reproducible from the
# pinned checkpoint via scripts/export_cross_encoder_onnx.py.
artifacts/onnx/

# Cached pipeline feature passes. Keyed on bundle id, so they are valid only on
# the host that built that bundle; regenerate with `reportfinder-train`.
artifacts/feature_cache/

# Docs and CI workflow kept local-only.
docs/
.github/
